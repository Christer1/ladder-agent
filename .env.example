# Base URL of ladder-backend (no trailing slash). Required for production builds.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
# true = use MSW mock handlers in src/mocks instead of the real backend
NEXT_PUBLIC_USE_MOCKS=true
# Partner this deployment serves (public identifier, not a secret)
NEXT_PUBLIC_PARTNER_ID=zenith
NEXT_PUBLIC_PARTNER_NAME=Zenith
NEXT_PUBLIC_PARTNER_TAGLINE=Banking for a brighter future
# WhatsApp support link for the Get Help button (used when NEXT_PUBLIC_HELP_CHANNEL=whatsapp)
NEXT_PUBLIC_SUPPORT_WHATSAPP_URL=https://wa.me/2340000000000
# Get Help: web = in-page help chat (Firestore), whatsapp = the link above
NEXT_PUBLIC_HELP_CHANNEL=web
# Firebase web app for the help chat (public values; firestore.rules in ladder-backend protects the data)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ladder-fbe91.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ladder-fbe91
NEXT_PUBLIC_FIREBASE_APP_ID=
